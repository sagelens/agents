# Obtain a Gemini API key from Google AI Studio.
GEMINI_API_KEY=replace_with_your_rotated_key
# This hosted Gemma 4 model supports native function calling.
GEMINI_MODEL=gemma-4-31b-it
# grep_code cannot access anything outside this directory.
CODEBASE_ROOT=/absolute/path/to/the/codebase
# run_python uses this prebuilt local Docker image and never builds it automatically.
SANDBOX_IMAGE=agents-python-sandbox:1
# Enable optional local Phoenix tracing.
PHOENIX_ENABLED=false
# OTLP HTTP collector used by the agent.
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
# REST/UI base URL used by evaluation scripts.
PHOENIX_BASE_URL=http://localhost:6006
# Keep interactive traces separate from evaluation experiments.
PHOENIX_PROJECT_NAME=agents-dev
PHOENIX_EVAL_PROJECT=agents-evals
# Reuse Gemma as the optional LLM judge.
PHOENIX_EVAL_MODEL=gemma-4-31b-it

CLIENT_ID=690272568856-41sf31s08lofv5450ockrd9bv5e4t8n4.apps.googleusercontent.com
PROJECT_ID=yoda-498319
AUTH_URI=https://accounts.google.com/o/oauth2/auth
TOKEN_URI=https://oauth2.googleapis.com/token
AUTH_PROVIDER_C509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
CLIENT_SECRET=token
REDIRECT_URIS=http://localhost

# Existing Google resources used by /screen-resumes.
RESUME_FOLDER_ID=replace_with_shared_drive_folder_id
SHEET_ID=replace_with_shared_spreadsheet_id

# Required company identity for HITL-approved candidate outreach.
COMPANY_NAME=replace_with_real_company_name
SENDER_DISPLAY_NAME=Apurv Shukla
SENDER_ROLE=Hiring Team
REPLY_TO_EMAIL=shuklaapurv01@gmail.com
